{
  "name": "onova.server.push",
  "version": "1.0.0",
  "description": "Push notification server",
  "main": "index.js",
  "scripts": {
    "start": "yarn prod:build && yarn prod:start",
    "dev:start": "nodemon --ignore lib --exec babel-node index",
    "prod:build": "babel *.js -d lib --ignore .test.js",
    "prod:start": "node lib/index.js",
    "lint": "eslint *.js --color",
    "test": "NODE_ENV=test jest",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "agenda": "^1.0.3",
    "babel-eslint": "^9.0.0",
    "dotenv": "^6.0.0",
    "joi": "^13.7.0",
    "mongoose": "^6.13.10",
    "node-gcm": "^1.0.2",
    "raven": "^2.6.0",
    "shortid": "^2.2.0",
    "winston": "^3.0.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.1.0",
    "@babel/core": "^7.1.0",
    "@babel/node": "^7.0.0",
    "@babel/plugin-proposal-object-rest-spread": "^7.0.0",
    "@babel/preset-env": "^7.1.0",
    "@babel/preset-flow": "^7.0.0",
    "eslint": "^5.5.0",
    "eslint-config-prettier": "^3.0.1",
    "eslint-plugin-flowtype": "^2.50.0",
    "eslint-plugin-import": "^2.14.0",
    "eslint-plugin-prettier": "^2.6.2",
    "flow-bin": "^0.82.0",
    "nodemon": "^1.18.4",
    "prettier": "^1.15.0"
  },
  "engineStrict": true,
  "engines": {
    "node": ">=8.11",
    "npm": ">=5.6.0",
    "yarn": ">=1.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://bitbucket.org/onova/server.push.git"
  },
  "private": true,
  "author": "Onova Team <hello@onova.co>",
  "nodemonConfig": {
    "ignore": [
      "lib/*"
    ],
    "delay": "2500"
  },
  "jest": {
    "verbose": true,
    "forceExit": true,
    "transform": {
      ".js": "<rootDir>/node_modules/babel-jest"
    }
  }
}

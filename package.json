{
  "name": "onova.server.push",
  "version": "0.0.0",
  "description": "Push notification server",
  "author": "Onova Team",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "yarn prod:build && yarn prod:start",
    "dev:start": "nodemon --ignore lib --exec babel-node index",
    "prod:build": "babel *.js -d lib --ignore .test.js",
    "prod:start": "node lib/index.js",
    "lint": "eslint *.js --color",
    "test": "NODE_ENV=test jest",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "agenda": "^1.0.3",
    "babel-cli": "^6.26.0",
    "babel-eslint": "^8.2.2",
    "babel-preset-env": "^1.6.1",
    "babel-preset-flow": "^6.23.0",
    "dotenv": "^5.0.1",
    "fbgraph": "^1.4.4",
    "joi": "^13.1.2",
    "mongoose": "^5.0.15",
    "node-gcm": "^0.14.10",
    "raven": "^2.4.2",
    "shortid": "^2.2.8",
    "winston": "^3.0.0-rc1"
  },
  "devDependencies": {
    "eslint": "^4.18.2",
    "eslint-config-prettier": "^2.9.0",
    "eslint-plugin-flowtype": "^2.46.1",
    "eslint-plugin-prettier": "^2.6.0",
    "flow-bin": "^0.66.0",
    "jest": "^22.4.2",
    "prettier": "^1.11.1",
    "supertest": "^3.0.0"
  },
  "engineStrict": true,
  "engines": {
    "node": ">=8.9",
    "npm": ">=5.6.0",
    "yarn": ">=1.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://bitbucket.org/onova/server.push.git"
  },
  "jest": {
    "verbose": true,
    "forceExit": true,
    "transform": {
      ".js": "<rootDir>/node_modules/babel-jest"
    }
  }
}
